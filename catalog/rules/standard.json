[
  {
    "id": "r_seite_boden",
    "name": "Seite an Boden/Traverse, eingestellt",
    "art": "verbindung",
    "prioritaet": 10,
    "gilt_fuer": {
      "bauweise": [
        "seiten_durchgehend"
      ]
    },
    "teil_a": [
      "seite_l",
      "seite_r"
    ],
    "teil_b": [
      "boden",
      "deckel",
      "traverse_vorne",
      "traverse_hinten",
      "zwischenboden"
    ],
    "stoss": "stumpf_flaeche_kante",
    "elemente": [
      {
        "beschlag": "set:verbinder",
        "verteilung": {
          "modus": "randabstand_max",
          "randabstand": "=P.verbindung.randabstand",
          "max_abstand": "=P.verbindung.max_abstand",
          "min_anzahl": 2
        }
      },
      {
        "beschlag": "set:duebel",
        "bedingung": "=P.verbindung.duebel",
        "verteilung": {
          "modus": "randabstand_max",
          "randabstand": "=P.verbindung.randabstand",
          "max_abstand": "=P.verbindung.max_abstand",
          "min_anzahl": 2,
          "versatz": 32
        }
      }
    ]
  },
  {
    "id": "r_lochreihe",
    "name": "Lochreihe 32er-System",
    "art": "teil",
    "prioritaet": 50,
    "bedingung": "=P.lochreihe.aktiv",
    "gilt_fuer": {
      "vorlagen_ausser": [
        "US-SPUE"
      ]
    },
    "rollen": [
      "seite_l",
      "seite_r",
      "mittelwand"
    ],
    "bearbeitungen": [
      {
        "typ": "bohrreihe",
        "flaeche": "F1",
        "start": [
          "=S+P.lochreihe.start",
          "=P.lochreihe.abstand_vorne"
        ],
        "richtung": "+x",
        "raster": "=P.lochreihe.raster",
        "anzahl": "=floor((L-2*S-P.lochreihe.start-P.lochreihe.rand_oben_min)/P.lochreihe.raster)+1",
        "d": "=P.lochreihe.durchmesser",
        "tiefe": "=P.lochreihe.tiefe"
      },
      {
        "typ": "bohrreihe",
        "flaeche": "F1",
        "bedingung": "=P.lochreihe.abstand_hinten>0 and P.rueckwand.art=='genutet'",
        "start": [
          "=S+P.lochreihe.start",
          "=W-P.rueckwand.abstand_hinten-P.lochreihe.abstand_hinten"
        ],
        "richtung": "+x",
        "raster": "=P.lochreihe.raster",
        "anzahl": "=floor((L-2*S-P.lochreihe.start-P.lochreihe.rand_oben_min)/P.lochreihe.raster)+1",
        "d": "=P.lochreihe.durchmesser",
        "tiefe": "=P.lochreihe.tiefe"
      },
      {
        "typ": "bohrreihe",
        "flaeche": "F1",
        "bedingung": "=P.lochreihe.abstand_hinten>0 and P.rueckwand.art!='genutet'",
        "start": [
          "=S+P.lochreihe.start",
          "=W-P.lochreihe.abstand_hinten"
        ],
        "richtung": "+x",
        "raster": "=P.lochreihe.raster",
        "anzahl": "=floor((L-2*S-P.lochreihe.start-P.lochreihe.rand_oben_min)/P.lochreihe.raster)+1",
        "d": "=P.lochreihe.durchmesser",
        "tiefe": "=P.lochreihe.tiefe"
      }
    ],
    "aussparen": [
      {
        "wo": "frontfeld_art",
        "art": [
          "schublade",
          "auszug"
        ]
      }
    ]
  },
  {
    "id": "r_rueckwand_nut",
    "name": "Rückwandnut",
    "art": "teil",
    "prioritaet": 20,
    "bedingung": "=P.rueckwand.art=='genutet'",
    "rollen": [
      "seite_l",
      "seite_r",
      "boden"
    ],
    "bearbeitungen": [
      {
        "typ": "nut",
        "flaeche": "F1",
        "von": [
          0,
          "=W-P.rueckwand.abstand_hinten-P.rueckwand.staerke"
        ],
        "bis": [
          "=L",
          "=W-P.rueckwand.abstand_hinten-P.rueckwand.staerke"
        ],
        "breite": "=P.rueckwand.staerke+0.5",
        "tiefe": "=P.rueckwand.nuttiefe",
        "bezug": "links"
      }
    ]
  }
]
