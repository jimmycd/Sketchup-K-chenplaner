[
  {
    "id": "r_lochreihe",
    "name": "Lochreihe 32er-System (Maße aus Seiten_.tcn: Start 55, Ende x-80, Reihen bei 35 / y-35 ab Fräskante)",
    "art": "teil",
    "prioritaet": 50,
    "bedingung": "=P.lochreihe.aktiv",
    "gilt_fuer": {
      "vorlagen_ausser": [
        "US-SPUE"
      ],
      "ohne_merkmal": [
        "ohne_lochreihe"
      ]
    },
    "rollen": [
      "seite_l",
      "seite_r",
      "mittelwand"
    ],
    "bearbeitungen": [
      {
        "typ": "bohrreihe",
        "flaeche": "F1",
        "start": [
          "=X0+P.lochreihe.start",
          "=Y0+P.lochreihe.abstand_vorne"
        ],
        "richtung": "+x",
        "raster": "=P.lochreihe.raster",
        "anzahl": "=floor((X1-P.lochreihe.rand_oben_min-X0-P.lochreihe.start)/P.lochreihe.raster)+1",
        "d": "=P.lochreihe.durchmesser",
        "tiefe": "=P.lochreihe.tiefe"
      },
      {
        "typ": "bohrreihe",
        "flaeche": "F1",
        "bedingung": "=P.lochreihe.abstand_hinten>0",
        "start": [
          "=X0+P.lochreihe.start",
          "=Y1-P.lochreihe.abstand_hinten"
        ],
        "richtung": "+x",
        "raster": "=P.lochreihe.raster",
        "anzahl": "=floor((X1-P.lochreihe.rand_oben_min-X0-P.lochreihe.start)/P.lochreihe.raster)+1",
        "d": "=P.lochreihe.durchmesser",
        "tiefe": "=P.lochreihe.tiefe"
      }
    ],
    "aussparen": [
      {
        "wo": "frontfeld_art",
        "art": [
          "schublade",
          "auszug"
        ]
      }
    ]
  },
  {
    "id": "r_rueckwand_nut",
    "name": "Rückwandnut",
    "art": "teil",
    "prioritaet": 20,
    "bedingung": "=P.rueckwand.art=='genutet'",
    "rollen": [
      "seite_l",
      "seite_r",
      "boden"
    ],
    "bearbeitungen": [
      {
        "typ": "nut",
        "flaeche": "F1",
        "von": [
          0,
          "=W-P.rueckwand.abstand_hinten-P.rueckwand.staerke"
        ],
        "bis": [
          "=L",
          "=W-P.rueckwand.abstand_hinten-P.rueckwand.staerke"
        ],
        "breite": "=P.rueckwand.staerke+0.5",
        "tiefe": "=P.rueckwand.nuttiefe",
        "bezug": "links"
      }
    ]
  },
