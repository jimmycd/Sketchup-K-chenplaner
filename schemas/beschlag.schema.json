{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kp/beschlag.schema.json",
  "title": "Beschlag-Definition",
  "type": "object",
  "required": [
    "id",
    "hersteller",
    "kategorie",
    "bohrbilder"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "hersteller": {
      "type": "string"
    },
    "artikelnummern": {
      "description": "Bestellpositionen je Stück Beschlag",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artnr"
        ],
        "properties": {
          "artnr": {
            "type": "string"
          },
          "bezeichnung": {
            "type": "string"
          },
          "menge": {
            "$ref": "common.schema.json#/$defs/mass",
            "default": 1
          },
          "bedingung": {
            "$ref": "common.schema.json#/$defs/bedingung"
          }
        }
      }
    },
    "bezeichnung": {
      "type": "string"
    },
    "kategorie": {
      "enum": [
        "verbinder",
        "duebel",
        "topfband",
        "montageplatte",
        "schubkastenfuehrung",
        "schubkastensystem",
        "klappenbeschlag",
        "bodentraeger",
        "sockelfuss",
        "schrankaufhaenger",
        "griff",
        "sonstiges"
      ]
    },
    "datenblatt": {
      "type": "string",
      "format": "uri"
    },
    "geprueft": {
      "type": "object",
      "description": "Wer das Bohrbild gegen das Datenblatt geprüft hat",
      "properties": {
        "von": {
          "type": [
            "string",
            "null"
          ]
        },
        "am": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "quelle": {
          "type": "string"
        }
      }
    },
    "modell_3d": {
      "type": "object",
      "properties": {
        "datei": {
          "type": "string",
          "description": ".skp im Bibliotheksordner"
        },
        "einfuegepunkt": {
          "$ref": "common.schema.json#/$defs/vec3"
        },
        "bezug_teil": {
          "$ref": "common.schema.json#/$defs/rolle"
        }
      }
    },
    "parameter": {
      "description": "Einstellbare Werte, in Formeln als V.<name>",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "default": {
            "$ref": "common.schema.json#/$defs/mass"
          },
          "werte": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          "beschreibung": {
            "type": "string"
          }
        }
      }
    },
    "varianten": {
      "description": "Auswahl nach Einbausituation, z. B. Schienenlänge nach Korpustiefe",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bedingung",
          "setze"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "bedingung": {
            "$ref": "common.schema.json#/$defs/bedingung"
          },
          "setze": {
            "type": "object",
            "additionalProperties": {
              "$ref": "common.schema.json#/$defs/mass"
            }
          }
        }
      }
    },
    "verteilung": {
      "description": "Wie viele Stück und wo, z. B. Topfbänder nach Türhöhe",
      "type": "object",
      "properties": {
        "achse": {
          "enum": [
            "x",
            "y"
          ]
        },
        "randabstand": {
          "$ref": "common.schema.json#/$defs/mass"
        },
        "anzahl_tabelle": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "bis",
              "anzahl"
            ],
            "properties": {
              "bis": {
                "type": "number"
              },
              "anzahl": {
                "type": "integer"
              }
            }
          }
        },
        "raster_fangen": {
          "type": "boolean",
          "default": false,
          "description": "Auf 32er-Lochreihe einrasten"
        }
      }
    },
    "bohrbilder": {
      "description": "Je betroffenes Teil ein Bohrbild",
      "type": "array",
      "items": {
        "$ref": "#/$defs/bohrbild"
      }
    }
  },
  "$defs": {
    "bohrbild": {
      "type": "object",
      "required": [
        "teil",
        "bezug",
        "bearbeitungen"
      ],
      "properties": {
        "teil": {
          "description": "Welches Teil der Verbindung: Rolle oder 'a'/'b' aus der Regel",
          "type": "string"
        },
        "bezug": {
          "type": "object",
          "description": "Ursprung der Bohrbild-Koordinaten auf dem Teil",
          "required": [
            "flaeche",
            "punkt"
          ],
          "properties": {
            "flaeche": {
              "$ref": "common.schema.json#/$defs/flaeche"
            },
            "punkt": {
              "enum": [
                "ecke_vorne_unten",
                "ecke_vorne_oben",
                "ecke_hinten_unten",
                "ecke_hinten_oben",
                "kante_vorne",
                "kante_hinten",
                "mitte",
                "verbindungsachse",
                "montagepunkt"
              ]
            },
            "spiegeln": {
              "enum": [
                "keins",
                "x",
                "y",
                "auto"
              ],
              "default": "auto",
              "description": "auto = links/rechts nach Teilrolle"
            }
          }
        },
        "bearbeitungen": {
          "description": "Wie Schema 4, aber Koordinaten dürfen Formeln sein",
          "type": "array",
          "items": {
            "$ref": "#/$defs/bearbeitung_vorlage"
          }
        }
      }
    },
    "bearbeitung_vorlage": {
      "type": "object",
      "required": [
        "typ"
      ],
      "properties": {
        "typ": {
          "enum": [
            "bohrung",
            "bohrreihe",
            "nut",
            "tasche",
            "kontur",
            "saegeschnitt",
            "makro"
          ]
        },
        "flaeche": {
          "$ref": "common.schema.json#/$defs/flaeche"
        },
        "bedingung": {
          "$ref": "common.schema.json#/$defs/bedingung"
        }
      },
      "additionalProperties": {
        "description": "Felder wie in teil.schema.json, Zahlen oder Formeln",
        "anyOf": [
          {
            "$ref": "common.schema.json#/$defs/mass"
          },
          {
            "type": "array"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    }
  }
}
