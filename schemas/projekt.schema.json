{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kp/projekt.schema.json",
  "title": "Küchenprojekt",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "standards"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "kunde": {
      "type": "string"
    },
    "kataloge": {
      "description": "Pfade zu Katalogordnern, Reihenfolge = Priorität",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "standards": {
      "$ref": "#/$defs/standards"
    },
    "zeilen": {
      "type": "array",
      "items": {
        "$ref": "zeile.schema.json"
      }
    }
  },
  "$defs": {
    "standards": {
      "type": "object",
      "required": [
        "korpus",
        "rueckwand",
        "hoehen",
        "tiefen",
        "lochreihe",
        "beschlag_set",
        "materialien"
      ],
      "properties": {
        "bauweise": {
          "description": "Verbindung Seite/Boden/Deckel",
          "enum": [
            "seiten_durchgehend",
            "boden_durchgehend",
            "seiten_durchgehend_deckel_aufgesetzt"
          ],
          "default": "seiten_durchgehend"
        },
        "korpus": {
          "type": "object",
          "required": [
            "staerke",
            "material"
          ],
          "properties": {
            "staerke": {
              "type": "number",
              "default": 19
            },
            "material": {
              "type": "string",
              "description": "Schlüssel in materialien"
            },
            "kante_sichtbar": {
              "type": "string",
              "description": "Schlüssel in kanten"
            },
            "kante_verdeckt": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "front": {
          "type": "object",
          "properties": {
            "staerke": {
              "type": "number",
              "default": 19
            },
            "material": {
              "type": "string"
            },
            "kante": {
              "type": "string"
            },
            "fuge": {
              "type": "number",
              "default": 3
            },
            "ueberstand_unten": {
              "type": "number",
              "default": 0
            },
            "griff": {
              "type": "string",
              "description": "Beschlag-ID oder 'grifflos'"
            }
          }
        },
        "rueckwand": {
          "type": "object",
          "required": [
            "art",
            "staerke"
          ],
          "properties": {
            "art": {
              "enum": [
                "genutet",
                "gefalzt",
                "aufgesetzt",
                "eingestellt"
              ]
            },
            "staerke": {
              "type": "number",
              "default": 8
            },
            "material": {
              "type": "string"
            },
            "nuttiefe": {
              "type": "number",
              "default": 10
            },
            "abstand_hinten": {
              "type": "number",
              "description": "Nutabstand von Hinterkante",
              "default": 16
            },
            "luft": {
              "type": "number",
              "description": "Spiel pro Seite in der Nut",
              "default": 1
            }
          }
        },
        "hoehen": {
          "type": "object",
          "properties": {
            "sockel": {
              "type": "number",
              "default": 100
            },
            "arbeitsplatte_staerke": {
              "type": "number",
              "default": 38
            },
            "arbeitshoehe": {
              "type": "number",
              "default": 910
            },
            "korpus_us": {
              "$ref": "common.schema.json#/$defs/mass",
              "default": "=P.hoehen.arbeitshoehe-P.hoehen.sockel-P.hoehen.arbeitsplatte_staerke"
            },
            "oberkante_hs": {
              "type": "number",
              "default": 2200
            },
            "korpus_hs": {
              "type": "number",
              "default": 720
            },
            "korpus_hoch": {
              "type": "number",
              "default": 2100
            }
          }
        },
        "tiefen": {
          "type": "object",
          "properties": {
            "us": {
              "type": "number",
              "default": 560
            },
            "hs": {
              "type": "number",
              "default": 350
            },
            "hoch": {
              "type": "number",
              "default": 560
            }
          }
        },
        "lochreihe": {
          "type": "object",
          "properties": {
            "aktiv": {
              "type": "boolean",
              "default": true
            },
            "durchmesser": {
              "type": "number",
              "default": 5
            },
            "tiefe": {
              "type": "number",
              "default": 12
            },
            "raster": {
              "type": "number",
              "default": 32
            },
            "abstand_vorne": {
              "type": "number",
              "default": 35,
              "description": "Reihe vorne ab Fräskante (Beispiel: 35)"
            },
            "abstand_hinten": {
              "$ref": "common.schema.json#/$defs/mass",
              "default": 35,
              "description": "Reihe hinten ab Fräskante (Beispiel: y-35); 0 = keine hintere Reihe"
            },
            "start": {
              "type": "number",
              "default": 55,
              "description": "Erstes Loch ab Fräskante am Bodenende (Seiten_.tcn: 55)"
            },
            "rand_oben_min": {
              "type": "number",
              "default": 80,
              "description": "Mindestabstand des letzten Lochs zur Fräskante am Ende (Seiten_.tcn: x-80)"
            }
          }
        },
        "verbindung": {
          "type": "object",
          "description": "Korpusverbindung mit Holzdübeln und Schrauben (kein Verbindersystem)",
          "properties": {
            "duebel": {
              "type": "object",
              "properties": {
                "d": {
                  "type": "number",
                  "default": 8
                },
                "tiefe_flaeche": {
                  "type": "number",
                  "default": 14,
                  "description": "Tiefe in der Seitenfläche (Beispiel Seiten_.tcn)"
                },
                "tiefe_stirn": {
                  "type": "number",
                  "default": 21,
                  "description": "Tiefe in der Stirnseite von Boden/Traverse/Deckel (Annahme: Dübel 35 mm - 14)"
                }
              }
            },
            "schraube": {
              "type": "object",
              "properties": {
                "d": {
                  "type": "number",
                  "default": 5,
                  "description": "Durchgangsloch in der Seite"
                },
                "werkzeug": {
                  "type": "integer",
                  "default": 12,
                  "description": "TpaCAD-Werkzeugnummer (#205)"
                }
              }
            }
          }
        },
        "beschlag_set": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "materialien": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "name",
              "staerke"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "staerke": {
                "type": "number"
              },
              "maserung": {
                "type": "boolean",
                "default": false
              },
              "ocl_material": {
                "type": "string",
                "description": "Name des SketchUp/OCL-Materials"
              },
              "farbe": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        },
        "kanten": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "staerke"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "staerke": {
                "type": "number"
              },
              "hoehe": {
                "type": "number"
              },
              "vorher_abziehen": {
                "type": "boolean",
                "default": true,
                "description": "Zuschnittmaß um Kantenstärke reduzieren"
              },
              "ocl_material": {
                "type": "string"
              }
            }
          }
        },
        "maschine": {
          "type": "object",
          "properties": {
            "exporter_profil": {
              "type": "string",
              "description": "Pfad zum TCN-Exporter-Profil"
            },
            "ausgabeordner": {
              "type": "string"
            }
          }
        },
        "einlegeboden": {
          "type": "object",
          "description": "Maße der Einlegeböden (Annahmen, bitte prüfen)",
          "properties": {
            "spiel_breite": {
              "type": "number",
              "default": 2,
              "description": "Gesamtspiel zur Innenbreite"
            },
            "abzug_tiefe": {
              "type": "number",
              "default": 20,
              "description": "Abzug von der Korpustiefe (Rücksprung vorne)"
            },
            "ruecksprung_vorne": {
              "type": "number",
              "default": 10
            },
            "material": {
              "type": "string"
            }
          }
        },
        "schubkasten": {
          "type": "object",
          "description": "Schubkastensystem Blum LEGRABOX free",
          "properties": {
            "material": {
              "type": "string",
              "description": "Schlüssel in materialien, 16 mm (Boden)"
            },
            "nl": {
              "type": "integer",
              "description": "Nennlänge; ohne Angabe: größte Standardlänge <= Korpustiefe - 3"
            },
            "boden_laenge_abzug": {
              "type": "number",
              "default": 10,
              "description": "Boden Tiefe = NL - Abzug (aus Schubkastenboden.tcn: 350 -> 340, bitte prüfen)"
            },
            "boden_breite_abzug": {
              "type": "number",
              "default": 35,
              "description": "Boden Breite = lichte Weite - Abzug (Blum: LW - 35)"
            },
            "last": {
              "enum": [
                40,
                70
              ],
              "default": 40,
              "description": "Tragfähigkeit in kg (bestimmt das Bohrbild der Seite)"
            }
          }
        },
        "zuschnitt": {
          "type": "object",
          "description": "Rohmaß für Etiketten",
          "properties": {
            "aufmass": {
              "type": "number",
              "default": 10,
              "description": "Aufmaß des Zuschnitts gegenüber dem Fräsmaß je Richtung in mm (Standard 10: Rohmaß = Fräsmaß + 10 mm)"
            }
          }
        }
      }
    }
  }
}
