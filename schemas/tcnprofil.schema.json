{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kp/tcnprofil.schema.json",
  "title": "TCN-Exporter-Profil",
  "type": "object",
  "required": [
    "id",
    "flaechen"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "maschine": {
      "type": "string"
    },
    "flaechen": {
      "description": "Konzept-Fläche F1..F6 -> TpaCAD-Flächennummer (1 oben, 2 unten, 3 vorne, 4 rechts, 5 hinten, 6 links). Fehlende Fläche = nicht bearbeitbar",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/flaeche"
      },
      "additionalProperties": {
        "type": "integer"
      }
    },
    "ursprung": {
      "type": "object",
      "properties": {
        "ecke": {
          "enum": [
            "links_vorne",
            "links_hinten",
            "rechts_vorne",
            "rechts_hinten"
          ]
        },
        "x_spiegeln": {
          "type": "boolean"
        },
        "y_spiegeln": {
          "type": "boolean"
        }
      }
    },
    "werkzeuge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "art"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "art": {
            "enum": [
              "bohrer_durch",
              "bohrer_flach",
              "topfbohrer",
              "lochreihenbohrer",
              "horizontalbohrer",
              "fraeser",
              "nutfraeser",
              "graviermesser_v",
              "graviermesser_rund",
              "saege",
              "nutsaege_x",
              "nutsaege_y",
              "schlosskastenaggregat"
            ]
          },
          "d": {
            "type": [
              "number",
              "null"
            ],
            "description": "Durchmesser bzw. Sägeblattbreite; null = unbekannt"
          },
          "max_tiefe": {
            "type": "number"
          },
          "flaechen": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/flaeche"
            }
          },
          "notiz": {
            "type": "string"
          },
          "nummer": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Werkzeugnummer in TpaCAD (#205 bzw. #8516); null = noch zu erfassen"
          }
        }
      }
    },
    "pruefungen": {
      "type": "object",
      "properties": {
        "min_randabstand": {
          "type": "number"
        },
        "min_restwand": {
          "type": "number",
          "description": "Mindestmaterial unter Sackbohrung"
        },
        "kollision_toleranz": {
          "type": "number"
        }
      }
    },
    "steuerung": {
      "type": "string",
      "description": "Steuerungssoftware, z. B. TpaCAD"
    },
    "achsen": {
      "type": "integer"
    },
    "tcn": {
      "type": "object",
      "description": "Dateiformat TpaCAD TCN",
      "properties": {
        "kopfzeile": {
          "type": "string",
          "default": "TPA\\ALBATROS\\EDICAD\\02.00:1224:r0w0h0s1"
        },
        "zeilenende": {
          "enum": [
            "crlf",
            "lf"
          ],
          "default": "crlf"
        },
        "bohrer_werkzeugtyp": {
          "type": "integer",
          "default": 0,
          "description": "#1001 bei Bohrung nach Durchmesser"
        },
        "saege_makro": {
          "type": "string",
          "default": "..\\custom\\mcr\\lame.tmcr",
          "description": "#8098 bei Säge X/Y"
        },
        "durchbohr_zugabe": {
          "type": "number",
          "default": 1,
          "description": "Zusätzliche Tiefe bei Durchgangsbohrung"
        },
        "tcn_version": {
          "type": "string",
          "default": "2.6.14"
        },
        "makro_pfad": {
          "type": "string",
          "default": "..\\custom\\mcr\\"
        }
      }
    },
    "wenden": {
      "type": "object",
      "description": "Zweite Aufspannung für Bearbeitungen auf F2 (nicht bearbeitbar)",
      "properties": {
        "spiegeln": {
          "enum": [
            "x",
            "y"
          ],
          "default": "y",
          "description": "Drehachse: y = um die Längsachse wenden, y' = W - y"
        }
      }
    },
    "bearbeitung_auf": {
      "enum": [
        "fertigmass",
        "zuschnittmass"
      ],
      "default": "fertigmass",
      "description": "zuschnittmass: Rohteil wird vor dem Kantenanleimen bearbeitet; Koordinaten werden um (Zuschnitt - Fertig)/2 verschoben"
    }
  }
}
